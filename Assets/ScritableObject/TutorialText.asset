  m_Script: {fileID: 11500000, guid: f7e738f9d64c2d54b960159c48581a4c, type: 3}
  m_Name: TutorialText
  m_EditorClassIdentifier: 
  japaneseTexts:
  - titie: "\u30C1\u30E5\u30FC\u30C8\u30EA\u30A2\u30EB1"
    Description: "\"\u53F3\u30B3\u30F3\u30C8\u30ED\u30FC\u30E9\u30FC\u306E\u30C8\u30EA\u30AC\u30FC\u3092\u5F15\u304F\u3068\\n\u5F3E\u3092\u767A\u5C04\u3067\u304D\u307E\u3059\u3002\\n\u5168\u3066\u306E\u7684\u3092\u7834\u58CA\u3057\u307E\u3057\u3087\u3046\uFF01\",\r\n"
  - titie: "\u30C1\u30E5\u30FC\u30C8\u30EA\u30A2\u30EB2"
    Description: "\"\u6575\u304C\u51FA\u73FE\u3057\u307E\u3057\u305F\u3002\\n\u898B\u3048\u3066\u3044\u308B\u6575\u306F\u5012\u305B\u307E\u305B\u3093\u3002\\n\u76EE\u306E\u524D\u306E\u6575\u3092\u4E09\u56DE\u6483\u3063\u3066\u78BA\u8A8D\u3057\u307E\u3057\u3087\u3046\uFF01\","
  - titie: "\u30C1\u30E5\u30FC\u30C8\u30EA\u30A2\u30EB3"
    Description: "\"\u898B\u3048\u306A\u3044\u6575\u306F\u5012\u3059\u3053\u3068\u304C\u3067\u304D\u307E\u3059\u3002\\n\u30D1\u30FC\u30C8\u30CA\u30FC\u306B\u6575\u306E\u5C45\u5834\u6240\u3092\u4F1D\u3048\u3066\\n\u653B\u6483\u3057\u307E\u3057\u3087\u3046\uFF01\",\n"
  - titie: "\u30C1\u30E5\u30FC\u30C8\u30EA\u30A2\u30EB4"
    Description: "\"\u4EF2\u9593\u3068\u5354\u529B\u3057\u3066\\n\u751F\u304D\u6B8B\u308A\u307E\u3057\u3087\u3046\uFF01\\n\u30B2\u30FC\u30E0\u30B9\u30BF\u30FC\u30C8\u3067\u3059\uFF01\"\n"
  englishTexts:
  - titie: Tutorial 1
    Description: '"Pull the right controller trigger\nto shoot bullets.\nDestroy
      all the targets!",'
  - titie: Tutorial 2
    Description: '"Enemies have appeared.\nVisible enemies cannot be defeated.\nShoot
      the enemy in front of you three times to check!",

'
  - titie: Tutorial 3
    Description: '"Invisible enemies can be defeated.\nCommunicate the enemy''s location
      to your partner\nand attack!",'
  - titie: Tutorial 4
    Description: '"Cooperate with your partner\nand survive!\nThe game starts!"'
