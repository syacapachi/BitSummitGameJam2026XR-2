  m_Script: {fileID: 11500000, guid: f7e738f9d64c2d54b960159c48581a4c, type: 3}
  m_Name: TutorialText
  m_EditorClassIdentifier: 
  japaneseTexts:
  - titie: "\u30C1\u30E5\u30FC\u30C8\u30EA\u30A2\u30EB1"
    Description: "\"\u5DE6\u53F3\u306E\u30B9\u30C6\u30A3\u30C3\u30AF\u3067\u79FB\u52D5\u3067\u304D\u307E\u3059\u3002\\n\u53F3\u30B3\u30F3\u30C8\u30ED\u30FC\u30E9\u30FC\u306E\u30C8\u30EA\u30AC\u30FC\u3092\u5F15\u304F\u3068\\n\u5F3E\u3092\u767A\u5C04\u3067\u304D\u307E\u3059\u3002\\n\u5DE6\u30C8\u30EA\u30AC\u30FC\u3067\u30D4\u30F3\u3092\u6253\u3063\u3066\\n\u6575\u306E\u5834\u6240\u3092\u4EF2\u9593\u306B\u77E5\u3089\u305B\u307E\u3057\u3087\u3046\uFF01\\n\u5168\u3066\u306E\u6575\u3092\u99C6\u6EC5\u3057\u307E\u3057\u3087\u3046\uFF01\""
  - titie: "\u30C1\u30E5\u30FC\u30C8\u30EA\u30A2\u30EB2"
    Description: "\"\u6575\u304C\u51FA\u73FE\u3057\u307E\u3057\u305F\u3002\\n\u898B\u3048\u3066\u3044\u308B\u6575\u306F\u5012\u305B\u307E\u305B\u3093\u3002\\n\u76EE\u306E\u524D\u306E\u6575\u3092\u6483\u3063\u3066\u78BA\u8A8D\u3057\u307E\u3057\u3087\u3046\uFF01\","
  - titie: "\u30C1\u30E5\u30FC\u30C8\u30EA\u30A2\u30EB3"
    Description: "\"\u5DE6\u30B3\u30F3\u30C8\u30ED\u30FC\u30E9\u30FC\u306E\u30C8\u30EA\u30AC\u30FC\u3092\u5F15\u304F\u3068\\n\u30DE\u30FC\u30AB\u30FC\u3092\u7F6E\u304F\u3053\u3068\u304C\u3067\u304D\u307E\u3059\u3002\\n\u6575\u306E\u4F4D\u7F6E\u3092\u5473\u65B9\u306B\u4F1D\u3048\u307E\u3057\u3087\u3046\uFF01\",\n"
  - titie: "\u30C1\u30E5\u30FC\u30C8\u30EA\u30A2\u30EB4"
    Description: "\"\u898B\u3048\u306A\u3044\u6575\u306F\u5012\u3059\u3053\u3068\u304C\u3067\u304D\u307E\u3059\u3002\\n\u5473\u65B9\u306E\u8A18\u3057\u305F\u30DE\u30FC\u30AB\u306E\u4F4D\u7F6E\u3092\u6483\u3061\\n\u898B\u3048\u306A\u3044\u6575\u3092\u5012\u3057\u307E\u3057\u3087\u3046\uFF01\""
  englishTexts:
  - titie: Tutorial 1
    Description: '"Use the left and right sticks to move.\nPull the right controller
      trigger\nto shoot.\nUse the left trigger to place a pin\nand let your partner
      know\nwhere the enemy is!\nDefeat all the enemies!"'
  - titie: Tutorial 2
    Description: '"Enemies have appeared.\nVisible enemies cannot be defeated.\nShoot
      the enemy in front of you to check!",

'
  - titie: Tutorial 3
    Description: '"Pull the left controller trigger\n to place a marker.\nTell your
      partner where the enemies are!"'
  - titie: Tutorial 4
    Description: '"Invisible enemies can be defeated.\nShoot at the markers placed
      by your partner\nand defeat the invisible enemies!"'
