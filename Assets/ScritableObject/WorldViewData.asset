  m_Name: WorldViewData
  m_EditorClassIdentifier: 
  japaneseTitles:
  - "\u53CC\u5B50\u306E\u5316\u3051\u7269\u30CF\u30F3\u30BF\u30FC"
  - "\u4E0D\u601D\u8B70\u306A\u304A\u5C4B\u6577\u306E\u3072\u307F\u3064"
  - "\u4ECA\u56DE\u306E\u4F9D\u983C"
  - "\u64CD\u4F5C\u8AAC\u660E"
  englishTitles:
  - Twin Monster Hunters
  - The Secret of the Mansion
  - The Mission
  - Controls
  japaneseTexts:
  - "\u3075\u305F\u308A\u306F\u53CC\u5B50\u306E\u30A8\u30FC\u30B8\u30A7\u30F3\u30C8\u3002\\n\u304A\u4ED5\u4E8B\u306F\u300C\u5316\u3051\u7269\u9000\u6CBB\u300D\uFF01\\n\u4ECA\u56DE\u306E\u4F9D\u983C\u5834\u6240\u306F\u2026\\n\u68EE\u306E\u5965\u306B\u3042\u308B\u4E0D\u6C17\u5473\u306A\u304A\u5C4B\u6577\u3060\uFF01 "
  - "\u3053\u306E\u304A\u5C4B\u6577\u306B\u306F\u4E0D\u601D\u8B70\u306A\u30EB\u30FC\u30EB\u304C\u3042\u308B\u3002\\n\u81EA\u5206\u306B\u898B\u3048\u3066\u3044\u308B\u5316\u3051\u7269\u306B\u306F\\n\u653B\u6483\u304C\u304D\u304B\u306A\u3044\uFF01\\n\u898B\u3048\u3066\u3044\u306A\u3044\u76F8\u65B9\u3060\u3051\u304C\u5012\u305B\u308B\u3093\u3060\uFF01 "
  - "\u5316\u3051\u7269\u305F\u3061\u3092\u5168\u54E1\u5012\u3057\u3066\\n\u591C\u660E\u3051\u307E\u3067\u751F\u304D\u6B8B\u308C\uFF01\\n\u3084\u3089\u308C\u3066\u3057\u307E\u3046\u3068\u30B2\u30FC\u30E0\u30AA\u30FC\u30D0\u30FC\u3002\\n\u3075\u305F\u308A\u3067\u529B\u3092\u5408\u308F\u305B\u308D\uFF01 "
  - "\u53F3\u30B3\u30F3\u30C8\u30ED\u30FC\u30E9\u30FC\u306E\u30C8\u30EA\u30AC\u30FC\u3092\u5F15\u304F\u3068\\n\u5F3E\u304C\u51FA\u308B\u3088\uFF01\\n\u76F8\u65B9\u306B\u5316\u3051\u7269\u306E\u5834\u6240\u3092\u4F1D\u3048\u306A\u304C\u3089\\n\u4E00\u7DD2\u306B\u6226\u304A\u3046\uFF01 "
  englishTexts:
  - "We are twin agents.\\nOur job is monster hunting!\\nNext stop\u2026a creepy
    mansion\\ndeep in the forest! "
  - 'This mansion has a strange rule.\nMonsters you can see cannot be defeated!\nOnly
    your partner can attack them! '
  - 'Defeat all monsters and survive until dawn!\nIf you get defeated it''s game
    over.\nWork together! '
  - 'Pull the right trigger to shoot!\nTell your partner\nwhere the monsters are\nAnd
    fight together! '
